def check_even_odd(num):
    if num % 2==0:
        print("number is even")
    else:
        print("number is odd")

def check_prime(num):
    if num<= 1:
        print("number is not prime")
        return
    for i in range(2,num):
        if num % i == 0:
            print("number is not prime")
            return
    print("number is prime")

number = int(input("enter a number: "))
check_even_odd(number)
check_prime(number)
